# Copy this file to .env and replace every value. Never commit .env.
# On the live server these live in /etc/sprout/sprout.env instead (spec 5.2).

# Server settings (spec 5.2)
DATABASE_URL=mysql+pymysql://sprout:fake-dev-password@127.0.0.1:3306/sprout
SECRET_KEY=fake-secret-key-replace-me
SESSION_DAYS=14
PHOTO_DIR=./photos
VISION_API_KEY=fake-vision-api-key
BACKUP_REMOTE=git@github.com:example/fake-backup-repo.git

# Used only by docker-compose.yml to create the local database.
# MYSQL_PASSWORD must match the password inside DATABASE_URL.
MYSQL_PASSWORD=fake-dev-password
MYSQL_ROOT_PASSWORD=fake-root-password
